<!-- Título da página de pesquisa -->
<h1 class="mb-3">{{titulo_pagina}}</h1>

<!-- Formulário de pesquisa enviado via POST -->
<form method="POST" action="/oficina/pesquisa" class="mb-3">
    <div class="mb-3">
        <label for="termo" class="form-label">
            Título da oficina
        </label>
        <input type="text" class="form-control" id="termo" name="termo" value="{{termo}}" required />
    </div>

    <button type="submit" class="btn btn-primary">Pesquisar</button>
</form>



<!-- Exibe instrução antes da primeira pesquisa ou o resultado após pesquisar -->
{{#if realizou_pesquisa}}
  {{#if sem_resultados}}
    <p>Nenhuma oficina encontrada.</p>
  {{else}}
    <!-- Lista simples com links para a consulta de cada oficina -->
    <ul>
      {{#each oficinas}}
        <li>
          <a href="/oficina/consulta/{{this.id}}">{{this.titulo}}</a>
        </li>
      {{/each}}
    </ul>
  {{/if}}
{{else}}
  <p>Digite um termo para pesquisar pelo título da oficina.</p>
{{/if}}