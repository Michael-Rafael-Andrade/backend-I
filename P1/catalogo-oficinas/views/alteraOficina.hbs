<!-- Título da tela de edição vindo do contexto -->
<h1 class="mb-3">{{titulo_pagina}}</h1>

<!-- Formulário enviado via POST para atualizar a oficina pelo ID -->
<form method="POST" action="/oficina/altera/{{id}}">
    <!-- Campo Título -->
    <div class="mb-3">
        <label for="titulo" class="form-label">Título</label>
        <input type="text" class="form-control" id="titulo" name="titulo" value="{{titulo}}" required />
    </div>

    <!-- Campo Responsável -->
    <div class="mb-3">
        <label for="responsavel" class="form-label">Responsável</label>
        <input type="text" class="form-control" id="responsavel" name="responsavel" value="{{responsavel}}" required />
    </div>

    <!-- Campo Descrição com suporte a várias linhas -->
    <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <textarea class="form-control" id="descricao" name="descricao" rows="5" required>{{descricao}}</textarea>
    </div>

    <!-- Campo Carga horária inteira de 1 a 40 -->
    <div class="mb-3">
        <label for="carga_horaria" class="form-label">
            Carga horária total (em horas)
        </label>
        <input type="number" class="form-control" id="carga_horaria" name="carga_horaria" min="1" max="40" step="1"
            value="{{carga_horaria}}" required />
    </div>

    <!-- Botões de ação: Salvar e Cancelar (volta para a tela de consulta) -->
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a href="/oficina/consulta/{{id}}" class="btn btn-secondary">
        Cancelar
    </a>
</form>