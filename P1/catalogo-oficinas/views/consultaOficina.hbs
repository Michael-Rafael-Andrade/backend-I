<!-- Título da tela de consulta vindo do contexto -->
<h1 class="mb-3">{{titulo_pagina}}</h1>

<!-- Exibição de todos os atributos da oficina -->
<div class="mb-3">
    <strong>ID</strong>
    <div>{{id}}</div>
</div>

<div class="mb-3">
    <strong>Título</strong>
    <div>{{titulo}}</div>
</div>

<div class="mb-3">
    <strong>Responsável</strong>
    <div>{{responsavel}}</div>
</div>

<div class="mb-3">
    <strong>Carga horária total</strong>
    <div>{{carga_horaria}} h</div>
</div>

<div class="mb-3">
    <strong>Inscrições</strong>
    <div>
        {{#if aberta}}
            Abertas
        {{else}}
            Encerradas
        {{/if}}
    </div>
</div>

<div class="mb-3">
    <strong>Descrição</strong>
    <pre>{{descricao}}</pre>
</div>

<!-- Botão para acessar a edição da oficina -->
<a href="/oficina/altera/{{id}}" class="btn btn-primary">
    Editar
</a>